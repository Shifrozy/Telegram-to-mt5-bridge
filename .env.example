# ==========================================
# Telegram to MT5 Bridge Configuration
# ==========================================

# 1. Telegram Settings
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram User IDs allowed to execute trades (Security measure)
# To find your ID, message @userinfobot on Telegram. Leave blank to allow any user (testing only).
TELEGRAM_ALLOWED_USERS=

# 2. MT5 Account Settings (Optional)
# If your MT5 terminal is already running and logged in, you can leave these blank.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# 3. Trading & Execution Settings
# Default lot size when not specified in signal
DEFAULT_LOT_SIZE=0.01

# Max slippage tolerance in points
DEFAULT_DEVIATION=20

# Magic number identifier for trades opened by this bridge
MAGIC_NUMBER=100888

# Broker symbol suffix (e.g., 'm' for Exness Standard, '.pro', or leave empty for auto-detection)
SYMBOL_SUFFIX=

# Enable auto-detection of broker symbol suffixes (Recommended: True)
AUTO_DETECT_SUFFIX=True

# 4. Safety & Mode Settings
# Set to True for dry-run simulation mode (parses signals and simulates execution without placing real orders)
DRY_RUN=False

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
